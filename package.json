{
  "name": "@dannyge/openclaw-memory-inject",
  "version": "0.1.1",
  "description": "OpenClaw plugin: auto-inject recent memory/*.md files into new sessions via before_prompt_build hook.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "hooks": ["./dist/index.js"]
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "test:watch": "node --test --import tsx --watch test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "version-check": "node scripts/check-version.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "memory",
    "session",
    "context",
    "context-injection"
  ],
  "author": "dannyge",
  "license": "MIT",
  "homepage": "https://github.com/dannyge/openclaw-memory-inject#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyge/openclaw-memory-inject.git"
  },
  "bugs": {
    "url": "https://github.com/dannyge/openclaw-memory-inject/issues",
    "email": "dannyge@users.noreply.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0"
  }
}
