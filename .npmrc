# Treat the `engines` field as mandatory for THIS project's development.
# Fails install/typecheck when run on an unsupported Node version (EBADENGINE).
#
# Note: this only affects the local checkout and CI — it is NOT published to
# the npm tarball (the `files` allowlist excludes it). Downstream consumers
# still get npm's default advisory-only `engines` warning.
engine-strict=true
